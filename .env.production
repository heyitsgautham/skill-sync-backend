# SkillSync Backend - Production Environment Variables
# This file documents the environment variables needed for production deployment
# Set these in Google Cloud Secret Manager or Cloud Run environment variables

# ==================== DATABASE ====================
# For Cloud SQL: postgresql://username:password@/dbname?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
# For external DB (Supabase/Neon): postgresql://username:password@host:port/dbname
DATABASE_URL=postgresql://user:password@host:port/skillsync

# ==================== SECURITY ====================
SECRET_KEY=generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==================== SERVER ====================
PORT=8000
ENVIRONMENT=production

# ==================== CORS ====================
# Update with your Vercel frontend URL
ALLOWED_ORIGINS=https://your-app.vercel.app,https://www.your-app.vercel.app

# ==================== GOOGLE AI ====================
GOOGLE_API_KEY=your-google-api-key-here

# Gemini API Keys (load balancing)
GEMINI_KEY_RESUME_PARSING=your-gemini-key-1
GEMINI_KEY_MATCHING_EXPLANATION=your-gemini-key-2
GEMINI_KEY_SKILLS_EXTRACTION=your-gemini-key-3
GEMINI_KEY_EMBEDDING_GENERATION=your-gemini-key-4
GEMINI_KEY_CANDIDATE_SUMMARY=your-gemini-key-5
GEMINI_KEY_INTERNSHIP_ANALYSIS=your-gemini-key-6
GEMINI_KEY_ACHIEVEMENT_EXTRACTION=your-gemini-key-7
GEMINI_KEY_FALLBACK_1=your-gemini-key-8
GEMINI_KEY_FALLBACK_2=your-gemini-key-9
GEMINI_KEY_FALLBACK_3=your-gemini-key-10

# ==================== CHROMADB ====================
# For production, consider using persistent volume or cloud storage
CHROMA_DB_PATH=./data/chroma_db

# ==================== FILE UPLOADS ====================
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./app/public/resumes

# ==================== AWS S3 ====================
# Required for production - don't store files locally in Cloud Run
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=skillsync-resumes-production

# ==================== EMAIL ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=your-email@gmail.com
SENDER_NAME=SkillSync
FRONTEND_URL=https://your-app.vercel.app
